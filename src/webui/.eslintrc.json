{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "rules": {
    "max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["warn", { "max": 50, "skipBlankLines": true, "skipComments": true }],
    "no-magic-numbers": ["warn", { "ignore": [0, 1, -1, 200, 404, 500, 1000, 3000] }],
    "no-restricted-imports": ["error", {
      "paths": [{
        "name": "axios",
        "message": "Please use @/api/client for unified requests"
      }],
      "patterns": [
        {
          "group": ["axios/*"],
          "message": "Please use @/api/client for unified requests"
        }
      ]
    }],
    "no-restricted-syntax": ["error", {
      "selector": "CallExpression[callee.name='fetch']",
      "message": "Direct fetch() is forbidden. Please use @/api modules."
    }],
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "build/",
    "*.config.js",
    "*.config.ts"
  ],
  "overrides": [
    {
      "files": ["src/pages/**/*.tsx"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["**/api/*", "**/../api/*", "**/../../api/*", "**/../../../api/*"],
              "message": "页面禁止直接 import api/, 必须通过 hooks/ 包装。"
            }
          ]
        }]
      }
    },
    {
      "files": ["src/api/http.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["server/**/*.ts"],
      "rules": {
        "no-magic-numbers": "off"
      }
    }
  ]
}
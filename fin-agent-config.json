{
  "mcpServers": {
    "fin-agent": {
      "command": "node",
      "args": ["./fin-agent-mcp-server/dist/index.js"],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}",
        "FRED_API_KEY": "${FRED_API_KEY}",
        "OILPRICE_API_KEY": "${OILPRICE_API_KEY}",
        "HTTP_PROXY": "${HTTP_PROXY}",
        "HTTPS_PROXY": "${HTTPS_PROXY}"
      }
    },
    "stock-scanner": {
      "command": "npx",
      "args": ["-y", "stock-scanner-mcp", "--enable-workspace"],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}",
        "FRED_API_KEY": "${FRED_API_KEY}"
      }
    },
    "sec-edgar": {
      "command": "npx",
      "args": ["-y", "mcp-edgar"]
    },
    "fear-greed": {
      "command": "npx",
      "args": ["-y", "mcp-server-fear-greed"]
    },
    "oil-price": {
      "command": "npx",
      "args": ["-y", "oilpriceapi-mcp"],
      "env": {
        "OILPRICE_API_KEY": "${OILPRICE_API_KEY}"
      }
    }
  },
  "cronJobs": {
    "daily_analysis": {
      "schedule": "0 9 * * 1-5",
      "timezone": "America/New_York",
      "task": "fin-agent daily",
      "description": "每个交易日美东9:00执行每日分析"
    },
    "weekly_review": {
      "schedule": "0 17 * * 5",
      "timezone": "America/New_York",
      "task": "fin-agent weekly",
      "description": "每周五美东17:00执行周度回顾"
    }
  },
  "signalWeights": {
    "technical": 0.35,
    "fundamental": 0.30,
    "sentiment": 0.10,
    "macro": 0.10,
    "options": 0.10,
    "insider": 0.05
  },
  "riskManagement": {
    "maxPositionSize": 0.10,
    "defaultStopLoss": 0.05,
    "minRiskRewardRatio": 1.5,
    "maxDailyTrades": 3,
    "oscillationCooldownDays": 3
  }
}

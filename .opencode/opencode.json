  "mcp": {
    "ashare-mcp-server": {
      "command": [
        "python",
        "agents/mcp/ashare/ashare_mcp_server.py"
      ],
      "description": "A 股数据 — akshare 行情、技术面、基本面、新闻",
      "enabled": true,
      "tools": [
        {
          "name": "ashare_quote",
          "description": "获取 A 股实时行情：最新价/涨跌幅/成交量/换手率",
          "category": "行情"
        },
        {
          "name": "ashare_technical_levels",
          "description": "获取 A 股技术指标：RSI/EMA/布林带/MACD/枢轴点/波动率",
          "category": "技术"
        },
        {
          "name": "ashare_fundamental_scan",
          "description": "获取 A 股基本面：ROE/净利润/营收/PE/PB/每股收益",
          "category": "基本面"
        },
        {
          "name": "ashare_news_sentiment",
          "description": "获取 A 股新闻及情绪评分",
          "category": "情绪"
        },
        {
          "name": "ashare_market_snapshot",
          "description": "获取 A 股大盘指数（上证/深证/创业板/沪深300/科创50等）",
          "category": "行情"
        },
        {
          "name": "ashare_fund_flow",
          "description": "获取 A 股个股资金流向（超大单/大单/中单/小单净流入）",
          "category": "资金"
        },
        {
          "name": "ashare_lhb",
          "description": "获取龙虎榜数据（最近上榜股票）",
          "category": "资金"
        },
        {
          "name": "ashare_sector_rotation",
          "description": "获取 A 股板块轮动分析：行业板块涨跌幅排名、动量信号、轮入/轮出板块",
          "category": "轮动"
        },
        {
          "name": "ashare_fund_flow_real",
          "description": "获取 A 股个股实时资金流向：主力/超大单/大单/中单/小单 净流入与净占比",
          "category": "资金"
        },
        {
          "name": "ashare_market_breadth",
          "description": "获取 A 股市场广度：涨跌家数、涨停/跌停家数、涨跌家数比、市场情绪",
          "category": "情绪"
        }
      ],
      "type": "local"
    },
    "fin-agent-mcp-server": {
      "command": [
        "node",
        "agents/mcp/core/dist/index.js"
      ],
      "description": "核心金融分析 MCP — 聚合多源数据",
      "enabled": true,
      "tools": [
        {
          "name": "market_snapshot",
          "description": "美股大盘快照：指数/涨跌/恐慌贪婪指数",
          "category": "行情"
        },
        {
          "name": "technical_levels",
          "description": "技术分析：RSI/EMA/布林带/MACD/枢轴点",
          "category": "技术"
        },
        {
          "name": "news_sentiment",
          "description": "新闻情绪分析：FinVul 新闻 + 情绪评分",
          "category": "情绪"
        },
        {
          "name": "fundamental_scan",
          "description": "基本面扫描：估值/财报/成长性",
          "category": "基本面"
        },
        {
          "name": "earnings_calendar",
          "description": "财报日历：upcoming 财报日期",
          "category": "基本面"
        },
        {
          "name": "sector_rotation",
          "description": "板块轮动：资金流向/热点赛道",
          "category": "资金"
        },
        {
          "name": "insider_trading",
          "description": "内部人交易：高管买卖/机构持仓变动",
          "category": "资金"
        },
        {
          "name": "fear_greed_index",
          "description": "恐慌贪婪指数：市场情绪指标",
          "category": "情绪"
        },
        {
          "name": "analyst_ratings",
          "description": "分析师评级：机构目标价/评级分布",
          "category": "基本面"
        },
        {
          "name": "options_greeks",
          "description": "期权希腊字母：Delta/Gamma/Theta/Vega",
          "category": "衍生品"
        },
        {
          "name": "commodity_prices",
          "description": "大宗商品价格：黄金/原油/铜/农产品",
          "category": "行情"
        },
        {
          "name": "sec_filings",
          "description": "SEC 财报：10-K/10-Q/8-K 文件查询",
          "category": "基本面"
        },
        {
          "name": "risk_gauge",
          "description": "风险评估：波动率/回撤/VaR 计算",
          "category": "风控"
        },
        {
          "name": "signal_fusion",
          "description": "信号融合：多维度加权计算",
          "category": "融合"
        }
      ],
      "type": "local"
    },
    "lib-mcp-server": {
      "command": [
        "node",
        "agents/lib/dist/index.js"
      ],
      "description": "纯逻辑工具 — 记忆/一致性/学习/魔鬼代言人",
      "enabled": true,
      "tools": [
        {
          "name": "memory_recall",
          "description": "记忆召回：查询历史分析记录",
          "category": "记忆"
        },
        {
          "name": "memory_save",
          "description": "记忆存储：保存分析结论",
          "category": "记忆"
        },
        {
          "name": "memory_verify",
          "description": "记忆验证：验证历史判断准确性",
          "category": "记忆"
        },
        {
          "name": "experience_summary",
          "description": "经验总结：分析准确率统计",
          "category": "记忆"
        },
        {
          "name": "rule_manage",
          "description": "规则管理：经验规则增删改查",
          "category": "记忆"
        },
        {
          "name": "consistency_check",
          "description": "逻辑一致性检查：检测矛盾信号",
          "category": "分析"
        },
        {
          "name": "devil_advocate",
          "description": "魔鬼代言人：反方论点生成",
          "category": "分析"
        },
        {
          "name": "conflict_resolver",
          "description": "冲突解决：多信号矛盾调和",
          "category": "分析"
        },
        {
          "name": "memory_learner",
          "description": "记忆学习：从历史交易中提取经验",
          "category": "记忆"
        }
      ],
      "type": "local"
    },
    "fred-mcp-server": {
      "command": [
        "node",
        "agents/mcp/fred/build/index.js"
      ],
      "description": "美联储经济数据 (FRED)",
      "enabled": true,
      "env": {
        "FRED_API_KEY": "{env:FRED_API_KEY}"
      },
      "tools": [
        {
          "name": "fred_search",
          "description": "搜索 FRED 经济数据序列",
          "category": "宏观"
        },
        {
          "name": "fred_get_series",
          "description": "获取 FRED 经济数据序列值",
          "category": "宏观"
        },
        {
          "name": "fred_browse",
          "description": "浏览 FRED 分类/发布/来源目录",
          "category": "宏观"
        }
      ],
      "type": "local"
    },
    "risk-mcp-server": {
      "command": [
        "python",
        "agents/mcp/risk/risk_mcp_server.py"
      ],
      "description": "本地风控计算 — 仓位管理，机构持仓分析",
      "enabled": true,
      "tools": [
        {
          "name": "position_sizing",
          "description": "仓位计算：Kelly/固定比例/波动率调整",
          "category": "风控"
        },
        {
          "name": "risk_gauge",
          "description": "止损计算：ATR/百分比/技术位止损",
          "category": "风控"
        },
        {
          "name": "institutional_flow",
          "description": "对冲建议：期权/反向ETF/行业对冲",
          "category": "风控"
        }
      ],
      "type": "local"
    },
    "cn-macro-mcp-server": {
      "command": [
        "python",
        "agents/mcp/cn-macro/cn_macro_mcp_server.py"
      ],
      "description": "中国宏观数据 — 信用/利率/PMI/通胀/行业/北向/外汇",
      "enabled": true,
      "tools": [
        {
          "name": "cn_macro_credit",
          "description": "信用数据：社融/M2/信贷",
          "category": "宏观"
        },
        {
          "name": "cn_macro_rates",
          "description": "利率数据：LPR/SHIBOR/国债收益率",
          "category": "宏观"
        },
        {
          "name": "cn_macro_pmi",
          "description": "PMI 数据：制造业/非制造业",
          "category": "宏观"
        },
        {
          "name": "cn_macro_inflation",
          "description": "通胀数据：CPI/PPI",
          "category": "宏观"
        },
        {
          "name": "cn_macro_industry",
          "description": "行业数据：工业增加值/利润",
          "category": "宏观"
        },
        {
          "name": "cn_macro_northbound",
          "description": "北向资金：净流入/持仓",
          "category": "资金"
        },
        {
          "name": "cn_macro_fx",
          "description": "外汇数据：汇率/外储",
          "category": "宏观"
        }
      ],
      "type": "local"
    },
    "sec-edgar-mcp": {
      "command": [
        "python",
        "agents/mcp/sec-edgar/sec_edgar_mcp/server.py"
      ],
      "description": "SEC EDGAR 财报查询",
      "enabled": true,
      "env": {
        "SEC_EDGAR_USER_AGENT": "FinAgent fin-agent@example.com"
      },
      "tools": [
        {
          "name": "get_cik_by_ticker",
          "description": "根据股票代码查找 CIK 编号",
          "category": "公司"
        },
        {
          "name": "get_company_info",
          "description": "获取公司基本信息",
          "category": "公司"
        },
        {
          "name": "search_companies",
          "description": "搜索 SEC EDGAR 公司",
          "category": "公司"
        },
        {
          "name": "get_company_facts",
          "description": "获取公司 XBRL 财务事实数据",
          "category": "公司"
        },
        {
          "name": "get_recent_filings",
          "description": "获取最近的 SEC 财报文件",
          "category": "文件"
        },
        {
          "name": "get_filing_content",
          "description": "获取 SEC 财报内容",
          "category": "文件"
        },
        {
          "name": "analyze_8k",
          "description": "分析 8-K 文件内容",
          "category": "文件"
        },
        {
          "name": "get_filing_sections",
          "description": "获取财报文件的章节",
          "category": "文件"
        },
        {
          "name": "get_financials",
          "description": "获取财务报表数据",
          "category": "财务"
        },
        {
          "name": "get_segment_data",
          "description": "获取分部数据",
          "category": "财务"
        },
        {
          "name": "get_key_metrics",
          "description": "获取关键财务指标",
          "category": "财务"
        },
        {
          "name": "compare_periods",
          "description": "对比不同期间的财务数据",
          "category": "财务"
        },
        {
          "name": "discover_company_metrics",
          "description": "发现公司可用的财务指标",
          "category": "财务"
        },
        {
          "name": "get_xbrl_concepts",
          "description": "获取 XBRL 概念数据",
          "category": "XBRL"
        },
        {
          "name": "discover_xbrl_concepts",
          "description": "发现可用的 XBRL 概念",
          "category": "XBRL"
        },
        {
          "name": "get_insider_transactions",
          "description": "获取内部人交易记录",
          "category": "内部人"
        },
        {
          "name": "get_insider_summary",
          "description": "获取内部人交易摘要",
          "category": "内部人"
        },
        {
          "name": "get_form4_details",
          "description": "获取 Form 4 详细信息",

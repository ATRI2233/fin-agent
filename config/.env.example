# 金融数据 API 密钥
# Finnhub API 密钥 — 用于获取美股实时行情、新闻、财务报表等数据
# 申请地址: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED (Federal Reserve Economic Data) API 密钥 — 用于获取美联储经济数据（利率、GDP、CPI 等）
# 申请地址: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# OilPrice API 密钥 — 用于获取原油及大宗商品价格数据
# 申请地址: https://oilpriceapi.com/
OILPRICE_API_KEY=your_oilprice_api_key_here

# Financial Modeling Prep API 密钥 — 用于获取财务报表、估值数据等
# 申请地址: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# SEC EDGAR 身份标识（邮箱地址）— 用于访问 SEC 上市公司文件
EDGAR_IDENTITY=your_email@example.com

# SEC EDGAR User-Agent — 访问 EDGAR 时使用的 User-Agent 标识
SEC_EDGAR_USER_AGENT=your_edgar_user_agent@example.com

# 数据库
# SQLite 数据库连接 URL — Fin-Agent 主数据库
FIN_AGENT_DATABASE_URL=sqlite:///./data/finagent.db
